# config.env — build feature flags.
# Sourced by build.sh. Values: true / false.

# Install KaoriOS Toolbox (system_ext/xbin/xeutoolbox + sepolicy).
install_toolbox=true

# Apply custom modifications from bin/modfile (Universal / UpdateFile / CustomApps).
install_mods=true

# Install user-supplied APKs from bin/modfile/CustomApps/.
install_custom_apps=true

# Target device codename filter (empty = all devices).
# Set to e.g. "lisa" to only apply device-specific mods for that device.
target_device=lisa

# Target HyperOS major (empty = auto from ROM; or "OS1" / "OS2" / "OS3").
target_os=OS1,OS2
