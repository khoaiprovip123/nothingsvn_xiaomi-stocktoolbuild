#!/sbin/sh
# update-binary — recovery flasher cho ROM NothingsVN (Xiaomi, chip Qualcomm).
# Cách dùng trong recovery: flash file .zip chứa images/ + super/ + META-INF/.
#
# Sửa các lỗi trước đây:
#   - Biến $Chip chưa bao giờ được set → luôn exit "mediatek" (flash LUÔN fail)
#   - Đọc META-INF/Data/* nhưng build ghi META-INF/* → sai đường dẫn
#   - set -e + grep không match → script chết giữa chừng
set -e

ZIP=$3
OUTFD=/proc/self/fd/$2
ui_print() { echo -e "ui_print $1\nui_print" > "$OUTFD"; }

# --- dọn + giải nén metadata ---
rm -rf /tmp/maianh
mkdir -p /tmp/maianh/bin
unzip -o "$ZIP" "META-INF/bin/*" -d /tmp/maianh >/dev/null 2>&1 || true
# Metadata nằm ở META-INF/Data/ (build.sh ghi vào đây).
unzip -o "$ZIP" "META-INF/Data/*" -d /tmp/maianh >/dev/null 2>&1 || true
chmod -R 0755 /tmp/maianh

partitionPath="/dev/block/bootdevice/by-name"
structure=$(cat /tmp/maianh/META-INF/Data/A 2>/dev/null || echo "")
codename=$(cat /tmp/maianh/META-INF/Data/CNAME 2>/dev/null || echo "")
chip=$(cat /tmp/maianh/META-INF/Data/Chip 2>/dev/null || echo "")
export PATH=/tmp/maianh/bin:$PATH

ui_print "> Check information... "

# --- kiểm tra chip (Qualcomm/ Snapdragon) ---
# Ưu tiên đọc file Chip; nếu thiếu thì suy từ hardware qua getprop.
if [ -z "$chip" ]; then
    hw=$(getprop ro.boot.hardware 2>/dev/null || true)
    platform=$(getprop ro.board.platform 2>/dev/null || true)
    chip="$hw $platform"
fi
case "$chip" in
    *[Ss]napdragon*|*qcom*|*msm*|*sdm*|*sm[0-9]*|*lahaina*|*taro*|*kalama*|*pineapple*|*bengal*|*kona*|*atoll*|*sm6150*|*trinket*|*lito*|*holi*|*cape*)
        : ;;
    *)
        ui_print "! Unsupported chip: $chip"
        ui_print "! This ROM is for Qualcomm (Snapdragon) devices only."
        exit 1 ;;
esac

# --- kiểm tra thiết bị ---
device=$(getprop ro.product.device 2>/dev/null || true)
if [ -n "$codename" ] && [ "$device" != "$codename" ]; then
    ui_print "! Device mismatch: this ROM is for '$codename', this device is '$device'."
    exit 1
fi

ui_print "> Starting install..."
ui_print " "
ui_print "----- Flashing firmware images -----"
ui_print " "

# --- flash từng image trong images/ ---
# Liệt kê file từ zip, loại bỏ entry thư mục và super (super flash riêng).
images=$(7zz l "$ZIP" 2>/dev/null | awk '/images\// {print $NF}' | grep -v '/$' | grep -v 'super' || true)
for imageFile in $images; do
    base=${imageFile##*/}
    partition=${base%%.*}
    [ -z "$partition" ] && continue
    if [ "$partition" = "cust" ]; then
        ui_print "> Flashing cust"
        unzip -p "$ZIP" "$imageFile" > "${partitionPath}/cust"
    elif [ "$structure" = "VAB" ]; then
        ui_print "> Flashing ${partition}_a / ${partition}_b"
        unzip -p "$ZIP" "$imageFile" > "${partitionPath}/${partition}_a"
        unzip -p "$ZIP" "$imageFile" > "${partitionPath}/${partition}_b"
    else
        ui_print "> Flashing ${partition}"
        unzip -p "$ZIP" "$imageFile" > "${partitionPath}/${partition}"
    fi
done

# --- flash super ---
ui_print "----- Flashing super -----"
if [ -f /tmp/maianh/bin/busybox ]; then
    unzip -p "$ZIP" "super/super.img" | busybox dd of="${partitionPath}/super" bs=4M conv=fsync 2>/dev/null \
        || unzip -p "$ZIP" "super/super.img" > "${partitionPath}/super"
else
    unzip -p "$ZIP" "super/super.img" > "${partitionPath}/super"
fi
ui_print "> super flashed"

# --- dọn dalvik cache để tránh bootloop sau khi thay system ---
rm -rf /data/dalvik-cache/arm/* 2>/dev/null || true
rm -rf /data/dalvik-cache/arm64/* 2>/dev/null || true

ui_print "----- Install Success -----"
ui_print " "
ui_print "Try format data if not boot"
ui_print "If bootloop: see docs/BOOT_TROUBLESHOOTING.md"

exit 0
